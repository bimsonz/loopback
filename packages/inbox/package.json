{
	"name": "@loopbackhq/inbox",
	"version": "0.3.0",
	"description": "The Loopback inbox as React components: read and answer what agents ask, live, inside your own app.",
	"homepage": "https://github.com/bimsonz/loopback/tree/main/packages/inbox#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bimsonz/loopback.git",
		"directory": "packages/inbox"
	},
	"files": [
		"dist",
		"src",
		"styles.css"
	],
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": "./src/index.ts",
		"./styles.css": "./styles.css"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			},
			"./styles.css": "./styles.css"
		},
		"access": "public"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@phosphor-icons/react": "catalog:",
		"react-markdown": "catalog:",
		"remark-gfm": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/kumo": "catalog:",
		"@effect/atom-react": "catalog:",
		"@loopbackhq/sdk": "workspace:*",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"effect": "catalog:",
		"jsdom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@cloudflare/kumo": "^2.15.0",
		"@effect/atom-react": "^4.0.6",
		"@loopbackhq/sdk": "workspace:^",
		"effect": "^4.0.6",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	}
}
