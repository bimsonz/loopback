{
	"name": "@loopbackhq/protocol",
	"version": "0.3.0",
	"description": "The Loopback API contract: the TypeSpec definition, its generated types and the OpenAPI document.",
	"homepage": "https://github.com/bimsonz/loopback/tree/main/packages/protocol#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bimsonz/loopback.git",
		"directory": "packages/protocol"
	},
	"files": [
		"dist",
		"openapi",
		"spec"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./document": "./src/generated/document.gen.ts",
		"./openapi.json": "./openapi/openapi.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			},
			"./document": {
				"types": "./dist/src/generated/document.gen.d.ts",
				"default": "./dist/src/generated/document.gen.js"
			},
			"./openapi.json": "./openapi/openapi.json"
		},
		"access": "public"
	},
	"scripts": {
		"generate": "tsp compile spec/main.tsp --config tspconfig.yaml",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@hono/zod-validator": "catalog:",
		"@typespec/compiler": "catalog:",
		"@typespec/http": "catalog:",
		"@typespec/openapi": "catalog:",
		"@typespec/openapi3": "catalog:",
		"@typespec/streams": "catalog:",
		"@typespec/versioning": "catalog:",
		"hono": "catalog:",
		"secure-json-parse": "catalog:",
		"typescript": "catalog:",
		"typespec-hono": "catalog:",
		"typespec-openapi-document": "catalog:",
		"zod": "catalog:"
	}
}
