{
	"name": "loopback",
	"private": true,
	"description": "A human-in-the-loop inbox for coding agents: an MCP server on Cloudflare Workers.",
	"keywords": [
		"cloudflare-workers",
		"coding-agents",
		"durable-objects",
		"human-in-the-loop",
		"mcp",
		"model-context-protocol"
	],
	"homepage": "https://github.com/bimsonz/loopback#readme",
	"bugs": {
		"url": "https://github.com/bimsonz/loopback/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bimsonz/loopback.git"
	},
	"type": "module",
	"scripts": {
		"generate": "pnpm --filter @loopbackhq/protocol generate",
		"generate:check": "pnpm generate && git diff --exit-code -- packages/protocol/src/generated packages/protocol/openapi packages/server/src/generated",
		"typecheck": "pnpm -r typecheck",
		"lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives --ignore-pattern \"**/*.gen.ts\"",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "pnpm -r test",
		"build": "pnpm -r build",
		"dev": "pnpm --filter loopback dev",
		"deploy": "pnpm --filter loopback run deploy"
	},
	"devDependencies": {
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": "^22.23.0 || ^24.22.0 || >=26.12.0",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@11.18.0"
}
