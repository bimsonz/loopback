	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bimsonz/loopback.git",
		"directory": "apps/loopback"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite build && vite preview",
